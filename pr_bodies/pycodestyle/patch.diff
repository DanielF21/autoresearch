+def _compile_checks(checks):
+    """Compile per-check argument getters for faster dispatch."""
+    compiled = []
+    append = compiled.append
+    for name, check, argument_names in checks:
+        append((name, check, attrgetter(*argument_names),
+                len(argument_names) == 1,
+                'checker_state' in argument_names))
+    return tuple(compiled)
 
 
